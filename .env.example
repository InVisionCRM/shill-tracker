# Copy to .env.local. Never commit real secrets.

# Pooled Neon connection string for the app (hostname contains -pooler).
DATABASE_URL=postgres://shill:shill@127.0.0.1:5432/shilltracker

# Direct Neon connection string for migrations (no -pooler). Optional locally.
DATABASE_URL_UNPOOLED=

# Bearer token for POST /api/ingest/posts, GET/POST/DELETE /api/influencers.
INGEST_SECRET=replace-with-a-long-random-string

# Bearer token for /api/cron/prices and /api/cron/scores.
# On Vercel, defining CRON_SECRET makes Cron send Authorization: Bearer $CRON_SECRET.
CRON_SECRET=replace-with-another-long-random-string
# Optional read-only bearer for GET /api/admin/health only (cron and ingest reject it).
HEALTH_TOKEN=

# Load fictional demo voices. Production deploys must leave this unset.
# SEED_DEMO=true

